  "sample_seed": 20261105,
  "scoring": "Judge errors are scored with mqm_human_scores.error_penalty, the same weights as human MQM (major 5, minor 1, minor punctuation 0.1, non-translation 25); quality = -penalty. Unparseable outputs are counted, retried never, and excluded from analysis; parse rate is reported.",
  "segments_per_pool": 150,
